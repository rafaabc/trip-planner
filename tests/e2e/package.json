{
  "name": "trip-planner-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "UI test suite for the Trip Planner (Playwright, playwright-bdd, Gherkin, Allure)",
  "type": "module",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:stability": "bddgen && playwright test --repeat-each=2",
    "report:html": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.4.0",
    "dotenv": "^16.4.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
