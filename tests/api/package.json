{
  "name": "trip-planner-api-tests",
  "version": "1.0.0",
  "private": true,
  "description": "API test suite for the Trip Planner (Mocha, Chai, Supertest, Mochawesome)",
  "scripts": {
    "test": "mocha",
    "test:report": "mocha --reporter mochawesome --reporter-options reportDir=reports,reportFilename=report,overwrite=true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1",
    "prettier": "^3.10.1",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
